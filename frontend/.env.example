# ============================================================================
# API Configuration
# ============================================================================
# Development: Use proxy to avoid CORS (default)
# The Vite dev server proxies /api requests to http://127.0.0.1:8000
VITE_API_URL=/api

# Production: With Docker Compose + nginx (recommended)
# Frontend and backend on same domain, nginx routes /api/* to backend
# This is baked into the build via docker-compose build args
# VITE_API_URL=/api

# Legacy: Direct connection (only if NOT using Docker Compose)
# If frontend/backend are separate and no nginx proxy:
# VITE_API_URL=http://54.163.207.252:8000

# Chrome extension ID for auth sync (from chrome://extensions when extension is loaded)
# VITE_EXTENSION_ID=your-extension-id

# ============================================================================
# Cloudflare Pages PR previews (see docs/deployment/CLOUDFLARE_PAGES_PREVIEWS.md)
# ============================================================================
# Detected automatically when CF_PAGES=1. Set explicitly for local preview builds:
# VITE_DEPLOY_ENV=preview
#
# Preview builds:
# - force VITE_API_URL=/preview-api (read-only mock; never production)
# - strip VITE_SENTRY_DSN, VITE_PERFORMANCE_ENDPOINT, VITE_RECAPTCHA_SITE_KEY
# - add noindex (meta + Pages _headers X-Robots-Tag)
# Do NOT set production secrets or https://compareintel.com/api on Pages.