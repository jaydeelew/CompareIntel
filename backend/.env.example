# ============================================================================
# CompareAI Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Documentation: docs/getting-started/ENVIRONMENT_SETUP.md
#
# IMPORTANT: Never commit your actual .env file to version control!
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================
# Development: Use SQLite for simplicity
DATABASE_URL=sqlite:///./compareintel.db

# Production: Use PostgreSQL for scalability
# DATABASE_URL=postgresql://user:password@localhost:5432/compareintel
# For Docker Compose:
# DATABASE_URL=postgresql://compareintel:compareintel@postgres:5432/compareintel

# ============================================================================
# Security & Authentication
# ============================================================================
# Generate a secure secret key:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 
# IMPORTANT: Use a strong, randomly generated key in production!
# Never use the default value shown here in production!
SECRET_KEY=your_secret_key_here_CHANGE_THIS_IN_PRODUCTION

# ============================================================================
# Internal host metrics (optional — Pulse polling)
# ============================================================================
# Bearer token for GET /internal/metrics/host. Leave unset (or empty) to disable
# the endpoint (it returns 404). Never commit a real token. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Production (nginx exact-match proxy). Missing/wrong token returns 401:
# curl -H "Authorization: Bearer $METRICS_TOKEN" https://compareintel.com/internal/metrics/host
# METRICS_TOKEN=

# ============================================================================
# API Keys
# ============================================================================
# OpenRouter API Key (Required)
# Get your free key at: https://openrouter.ai/keys
# Format: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# Email Configuration (Optional - for user verification emails)
# ============================================================================
# ZeptoMail / Zoho Configuration (Recommended)
# Create a Mail Agent at https://www.zoho.com/zeptomail/ → Setup Options → SMTP
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=your_zeptomail_smtp_password_here
MAIL_FROM=noreply@compareintel.com
MAIL_SERVER=smtp.zeptomail.com
MAIL_PORT=587

# Alternative SMTP providers:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ============================================================================
# Frontend URL (for email links)
# ============================================================================
# Development
FRONTEND_URL=http://localhost:5173

# Production
# FRONTEND_URL=https://compareintel.com

# ============================================================================
# Admin Notifications (Production only)
# ============================================================================
# Email to receive notification when a new user signs up at compareintel.com
# Only used when ENVIRONMENT=production; leave empty to disable
# NEW_USER_NOTIFICATION_EMAIL=your-email@example.com

# ============================================================================
# Environment
# ============================================================================
# Options: development, staging, production
# This affects CORS settings, error handling, and email sending behavior
ENVIRONMENT=development

# Exact browser-extension origins allowed for credentialed CORS (comma-separated).
# Each entry must be chrome-extension://<id> or moz-extension://<id> with a real id.
# Wildcards, paths, and other schemes are rejected at startup.
# Unset or empty: no extension origins are allowed (any installed extension is denied).
# Local unpacked extensions: copy the ID from chrome://extensions (or about:debugging).
# Production: set the Chrome Web Store / AMO id after publish.
# Example:
# EXTENSION_CORS_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef,moz-extension://12345678-1234-1234-1234-123456789abc
# EXTENSION_CORS_ORIGINS=

# ============================================================================
# Optional: Performance Tuning
# ============================================================================
# Gunicorn worker count (production mode only; development uses uvicorn with reload)
# Prefer WEB_CONCURRENCY (standard). GUNICORN_WORKERS is still accepted as a fallback.
# Production compose defaults to 2 workers on the 2 GB host.
# Consider database pool sizing when changing this: workers × (pool_size + max_overflow) × replicas
# WEB_CONCURRENCY=2
# GUNICORN_WORKERS=2

# These are currently hardcoded in model_runner.py but can be made configurable:
# MAX_CONCURRENT_REQUESTS=9
# INDIVIDUAL_MODEL_TIMEOUT=120
# BATCH_SIZE=9

# ============================================================================
# Database Connection Pooling (PostgreSQL only)
# ============================================================================
# These settings control SQLAlchemy connection pooling for PostgreSQL.
# SQLite ignores these settings and uses NullPool (no pooling).
#
# IMPORTANT: Size your pool based on the formula:
#   workers × (pool_size + max_overflow) × replicas ≤ database connection limit
#
# Defaults (safe for free-tier Postgres with ~20-100 connection limit):
#   2 workers × (5 + 10) × 1 replica = 30 total connections
#
# For larger production Postgres instances (e.g., 100-200 connections):
#   Consider increasing DB_POOL_SIZE=10 and DB_MAX_OVERFLOW=15
#   With 2 workers: 2 × (10 + 15) = 50 total connections
#
# DB_POOL_SIZE=5               # Persistent connections per worker
# DB_MAX_OVERFLOW=10           # Additional connections allowed beyond pool_size
# DB_POOL_TIMEOUT=30           # Seconds to wait for an available connection
# DB_POOL_RECYCLE=3600         # Recycle connections after this many seconds (1 hour)
# DB_POOL_PRE_PING=True        # Verify connections before use (prevents stale connections)

# ============================================================================
# Optional: Redis (for distributed rate limiting, caching, and spend caps)
# ============================================================================
# Enable Redis for stateless horizontal scaling across workers/replicas
# Without Redis, each worker maintains separate in-memory rate limits and cache
# Production spend caps fail closed if Redis is down (free compares blocked)
# REDIS_URL=redis://localhost:6379/0
# REDIS_ENABLED=true

# ============================================================================
# OpenRouter spend protection (issue #39) — required before launch
# ============================================================================
# App-level USD budgets tracked in Redis. 0 disables a cap.
# When the daily (or monthly) cap is reached, free/anonymous compares return
# HTTP 429 with "Please try again later." Paid users are unaffected unless a
# paid cap is also set.
# Jack must also set the OpenRouter dashboard key-level credit limit as a backstop.
# See docs/ops/OPENROUTER_SPEND_CAP.md
#
# OPENROUTER_DAILY_SPEND_CAP_USD=25
# OPENROUTER_MONTHLY_SPEND_CAP_USD=0
# OPENROUTER_PAID_DAILY_SPEND_CAP_USD=0
# OPENROUTER_PAID_MONTHLY_SPEND_CAP_USD=0
# Hard cap on completion tokens sent to OpenRouter (default 8192)
# OPENROUTER_MAX_OUTPUT_TOKENS=8192
# Fail closed for free compares if Redis is unavailable in production (default true)
# OPENROUTER_SPEND_FAIL_CLOSED=true
# Emergency in-memory counters in production (default false; per-worker only)
# OPENROUTER_SPEND_MEMORY_FALLBACK=false
# Alert email at 50% and 80% of the free/global cap (falls back to NEW_USER_NOTIFICATION_EMAIL)
# SPEND_ALERT_EMAIL=your-email@example.com

# ============================================================================
# Stripe (optional — billing, subscriptions, metered overage)
# ============================================================================
# FRONTEND_URL (section above) must match your SPA origin — Checkout success/cancel URLs use it.
# Dashboard → Settings → Customer portal: enable for test mode before "Manage billing" works locally.
# Create Prices in Stripe Dashboard; IDs look like price_...
# Webhook URL: {your-api}/api/billing/webhooks/stripe
# See docs/ops/STRIPE_WEBHOOK_RUNBOOK.md
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly recurring amounts must match TIER_PRICING in app config: $9 / $19 / $39 / $79
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_STARTER_PLUS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_PLUS=price_...
# Overage: OVERAGE_USD_PER_CREDIT = $0.013/credit; metered price on overage product
# STRIPE_OVERAGE_METER_ID=mtr_...
# STRIPE_OVERAGE_PRODUCT_ID=prod_...
# STRIPE_PRICE_OVERAGE=price_...

# ============================================================================
# Notes
# ============================================================================
# - All environment variables are loaded using python-dotenv
# - Variables are loaded from backend/.env (relative to backend directory)
# - Required variables: SECRET_KEY, OPENROUTER_API_KEY
# - Optional variables: All email-related variables, Stripe (above)
# - If email is not configured, verification emails will be skipped in development
